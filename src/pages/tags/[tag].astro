---
import type { BlogPost } from '../../lib/posts';
import { getPublishedPosts } from '../../lib/server/content';
import { groupPostsByTag, tagRouteParam } from '../../lib/taxonomy';
import PostList from '../../components/blog/PostList.astro';
import TaxonomyLayout from '../../layouts/TaxonomyLayout.astro';

export async function getStaticPaths() {
  return groupPostsByTag(await getPublishedPosts()).map(({ name, posts }) => ({
    params: { tag: tagRouteParam(name) },
    props: { tag: name, posts },
  }));
}

interface Props {
  tag: string;
  posts: BlogPost[];
}

const { tag, posts } = Astro.props;
---

<TaxonomyLayout kind="tags" subject={tag} count={posts.length}>
  <PostList posts={posts} variant="compact" emptyKey="tags.noPosts" />
</TaxonomyLayout>
