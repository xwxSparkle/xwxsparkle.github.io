---
import type { GetStaticPaths } from 'astro';
import { getPublishedPosts } from '../../lib/server/content';
import HomeLayout from '../../layouts/HomeLayout.astro';
import { createPostPages, type PostPage } from '../../lib/posts';

export const getStaticPaths = (async () => {
  const pages = createPostPages(await getPublishedPosts(), import.meta.env.BASE_URL);
  return pages.slice(1).map((page) => ({
    params: { page: String(page.currentPage) },
    props: { page },
  }));
}) satisfies GetStaticPaths;

interface Props {
  page: PostPage;
}

const { page } = Astro.props;
---

<HomeLayout page={page} />
