---
import { render, type CollectionEntry } from 'astro:content';
import { getPublishedPosts, getPostTranslation } from '../../lib/server/content';
import PostLayout from '../../layouts/PostLayout.astro';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const english = getPostTranslation(post);
const EnglishContent = english?.Content;
---

<PostLayout {...post.data} headings={headings} translation={english?.frontmatter}>
  <Content />
  <Fragment slot="english">{EnglishContent && <EnglishContent />}</Fragment>
</PostLayout>
