---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import FormattedDate from '../components/ui/FormattedDate.astro';
import TableOfContents from '../components/blog/TableOfContents.astro';
import PostTags from '../components/blog/PostTags.astro';
import Heading from '../components/ui/Heading.astro';
import SiteLayout from './SiteLayout.astro';
import {
  categoryHref,
  categoryLabel,
  categoryTranslationKey,
  normalizeCategory,
} from '../lib/taxonomy';

interface PostHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: ImageMetadata;
  tags?: string[];
  category?: string;
  headings?: PostHeading[];
  translation?: { title: string; description: string };
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags = [],
  category,
  headings = [],
  translation,
} = Astro.props;
const titleId = 'post-title';
const articleId = 'blog-post';
const titles = { en: translation?.title ?? title, zh: title };
const descriptions = { en: translation?.description ?? description, zh: description };
const hasEnglish = Boolean(translation) && Astro.slots.has('english');
const showTableOfContents = ['笔记', '评测'].includes(normalizeCategory(category ?? ''));
---

<SiteLayout
  title={titles.en}
  description={descriptions.en}
  titleTranslations={titles}
  descriptionTranslations={descriptions}
  image={heroImage}
>
  <article class="post" id={articleId}>
    <Heading
      title={titles.en}
      titleId={titleId}
      titleTranslations={titles}
      back={{ href: import.meta.env.BASE_URL, labelKey: 'post.all' }}
    >
      <div class="metadata">
        <span>
          <span data-i18n="post.published">Published</span> <FormattedDate date={pubDate} />
        </span>
        {updatedDate && (
          <span>
            <span data-i18n="post.updated">Updated</span> <FormattedDate date={updatedDate} />
          </span>
        )}
        {category && (
          <a
            href={categoryHref(category, import.meta.env.BASE_URL)}
            data-i18n={categoryTranslationKey(category)}
          >
            {categoryLabel(category)}
          </a>
        )}
      </div>
      <PostTags tags={tags} />
    </Heading>

    {heroImage && (
      <div class="hero-image">
        <Image width={1200} height={630} src={heroImage} alt="" loading="eager" />
      </div>
    )}

    {showTableOfContents && (
      <TableOfContents
        title={title}
        titleId={titleId}
        headings={headings}
        articleId={articleId}
        variant="mobile"
        titleTranslations={titles}
      />
    )}
    <div class="prose" data-post-content>
      <div lang="zh-CN" data-post-language={hasEnglish ? 'zh' : undefined}>
        <slot />
      </div>
      {hasEnglish && (
        <div lang="en" data-post-language="en">
          <slot name="english" />
        </div>
      )}
    </div>
  </article>
  {showTableOfContents && (
    <TableOfContents
      slot="toc"
      title={title}
      titleId={titleId}
      headings={headings}
      articleId={articleId}
      variant="desktop"
      titleTranslations={titles}
    />
  )}
</SiteLayout>

<style>
  .post {
    min-width: 0;
    max-width: 760px;
    margin: 0;
  }

  .metadata {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    color: rgb(var(--gray));
    font-size: 0.8rem;
  }

  .hero-image {
    min-width: 0;
    margin-bottom: var(--space-section);
  }

  .hero-image img {
    display: block;
    width: 100%;
    height: 320px;
    object-fit: cover;
    border: 1px solid rgb(var(--border));
    border-radius: var(--radius-card);
  }

  .prose {
    min-width: 0;
    font-size: 1.0625rem;
    line-height: 1.85;
  }

  .prose :global(p) {
    margin: 0 0 1.5em;
  }

  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    scroll-margin-top: 2rem;
    line-height: 1.35;
    letter-spacing: -0.02em;
  }

  .prose :global(h2) {
    margin: 2.75rem 0 1rem;
    font-size: var(--text-heading-2);
  }

  .prose :global(h3) {
    margin: 2rem 0 0.75rem;
    font-size: var(--text-heading-3);
  }

  .prose :global(h4) {
    margin: 1.75rem 0 0.75rem;
    font-size: var(--text-heading-4);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.5em;
    margin-bottom: 1.5em;
  }

  .prose :global(li + li) {
    margin-top: 0.4em;
  }

  .prose :global(blockquote) {
    margin: 1.75rem 0;
    font-size: 1em;
    color: rgb(var(--gray));
  }

  .prose :global(pre) {
    min-width: 0;
    max-width: 100%;
    overflow-x: auto;
    border: 1px solid rgb(var(--border));
    font-size: 0.85em;
    line-height: 1.65;
  }

  .prose :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.9em;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 0.65em 1em;
    border-bottom: 1px solid rgb(var(--border));
    text-align: left;
  }

  .prose :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 1.75rem auto;
  }

  @media (max-width: 1023px) {
    .prose :global(h2),
    .prose :global(h3),
    .prose :global(h4) {
      scroll-margin-top: var(--mobile-sidebar-offset, 4.5rem);
    }
  }
</style>
