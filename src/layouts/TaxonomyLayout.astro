---
import SiteLayout from './SiteLayout.astro';
import PostCount from '../components/blog/PostCount.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import { translate, type TranslationKey, type TranslationParams } from '../lib/i18n';
import {
  categoryHref,
  categoryLabel,
  tagHref,
  tagLabel,
  type TaxonomyGroup,
} from '../lib/taxonomy';

interface Props {
  kind: 'categories' | 'tags';
  subject?: string;
  count: number;
  groups?: readonly TaxonomyGroup[];
}

const { kind, subject, count, groups } = Astro.props;
const isCategory = kind === 'categories';
const directoryKey = isCategory ? 'nav.categories' : 'nav.tags';
const directoryHref = `${import.meta.env.BASE_URL}${kind}/`;
const label = (name: string, language: 'en' | 'zh') =>
  isCategory ? categoryLabel(name, language) : `#${tagLabel(name, language)}`;
const subjectTranslations = subject === undefined
  ? undefined
  : { en: label(subject, 'en'), zh: label(subject, 'zh') };
const titleKey: TranslationKey = subject === undefined
  ? directoryKey
  : isCategory ? 'categories.title' : 'tags.title';
const descriptionKey: TranslationKey = subject === undefined
  ? isCategory ? 'categories.description' : 'tags.description'
  : isCategory ? 'categories.postsDescription' : 'tags.postsDescription';
const params: TranslationParams = subject === undefined
  ? {}
  : isCategory ? { category: subject } : { tag: subject };
---

<SiteLayout
  title={translate(titleKey, 'en', params)}
  titleKey={titleKey}
  titleParams={params}
  description={translate(descriptionKey, 'en', params)}
  descriptionKey={descriptionKey}
  descriptionParams={params}
>
  <nav class="breadcrumbs" aria-label="Breadcrumbs" data-i18n-aria-label="navigation.breadcrumbs">
    <ol>
      <li><a href={import.meta.env.BASE_URL} data-i18n="nav.home">Home</a></li>
      <li>
        {subject === undefined ? (
          <span aria-current="page" data-i18n={directoryKey}>{translate(directoryKey)}</span>
        ) : (
          <a href={directoryHref} data-i18n={directoryKey}>{translate(directoryKey)}</a>
        )}
      </li>
      {subjectTranslations && (
        <li>
          <span aria-current="page" data-localized={JSON.stringify(subjectTranslations)}>
            {subjectTranslations.en}
          </span>
        </li>
      )}
    </ol>
  </nav>

  <header class="taxonomy-header">
    <h1
      id="taxonomy-title"
      data-page-heading
      data-i18n={subject === undefined ? directoryKey : undefined}
      data-localized={subjectTranslations && JSON.stringify(subjectTranslations)}
    >{subjectTranslations?.en ?? translate(directoryKey)}</h1>
    <PostCount count={count} />
  </header>

  <section class="taxonomy-content" aria-labelledby="taxonomy-title">
    {groups ? (
      groups.length > 0 ? (
        <ul class="taxonomy-directory">
          {groups.map(({ name, posts }) => (
            <li>
              <a
                href={isCategory ? categoryHref(name, import.meta.env.BASE_URL) : tagHref(name, import.meta.env.BASE_URL)}
                data-category-name={isCategory ? name : undefined}
              >
                <span data-localized={JSON.stringify({ en: label(name, 'en'), zh: label(name, 'zh') })}>
                  {label(name, 'en')}
                </span>
                <PostCount count={posts.length} />
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <EmptyState messageKey={isCategory ? 'home.emptyState' : 'tags.empty'} />
      )
    ) : <slot />}
  </section>
</SiteLayout>

<style>
  .breadcrumbs {
    margin-bottom: 1.25rem;
    color: rgb(var(--gray));
    font-size: 0.75rem;
    line-height: 1.6;
  }

  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .breadcrumbs li + li::before {
    margin: 0 0.5rem;
    color: rgba(var(--gray), 0.6);
    content: '/';
  }

  .breadcrumbs a {
    color: inherit;
    text-decoration: none;
  }

  .breadcrumbs a:is(:hover, :focus-visible) {
    color: rgb(var(--link));
  }

  .taxonomy-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
    margin-bottom: var(--space-stack);
    padding-bottom: var(--space-stack);
    border-bottom: 1px solid rgba(var(--border), 0.7);
  }

  h1 {
    min-width: 0;
    margin: 0;
    font-size: var(--text-card-title);
    line-height: 1.4;
    letter-spacing: -0.015em;
    overflow-wrap: anywhere;
  }

  .taxonomy-directory {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .taxonomy-content > :global(.empty-state) {
    padding: 1.5rem 0;
    border: 0;
    border-radius: 0;
  }

  .taxonomy-directory li + li {
    border-top: 1px solid rgba(var(--border), 0.45);
  }

  .taxonomy-directory a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-stack);
    min-height: 48px;
    padding: 0.75rem 0;
    color: rgb(var(--foreground));
    font-size: 0.875rem;
    line-height: 1.5;
    text-decoration: none;
  }

  .taxonomy-directory a:is(:hover, :focus-visible) {
    color: rgb(var(--link));
  }
</style>
