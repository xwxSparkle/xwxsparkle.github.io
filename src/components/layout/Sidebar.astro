---
import { NAV_ITEMS, PROFILE, SITE_TITLE } from '../../site.config';
import CatLogo from '../cat/CatLogo.astro';
import Preferences from '../controls/Preferences.astro';
import SiteCat from '../cat/SiteCat.astro';

interface Props {
  background: { src: string; width: number; height: number };
}

const { background } = Astro.props;
const normalizePath = (pathname: string) => '/' + pathname.split('/').filter(Boolean).join('/');
const basePath = normalizePath(import.meta.env.BASE_URL);
const stripBase = (pathname: string) => {
  const path = normalizePath(pathname);
  return basePath !== '/' && (path === basePath || path.startsWith(basePath + '/'))
    ? path.slice(basePath.length) || '/'
    : path;
};
const pathname = stripBase(Astro.url.pathname);
const navigation = NAV_ITEMS.map((item) => {
  const href = (basePath === '/' ? '' : basePath) + item.href;
  const targetPath = stripBase(new URL(href, Astro.url).pathname);
  const active =
    pathname === targetPath ||
    (targetPath === '/'
      ? /^\/page\/(?:[2-9]|[1-9]\d+)$/.test(pathname)
      : pathname.startsWith(targetPath + '/'));
  return { ...item, href, active };
});

// Bilibili icon source: https://github.com/simple-icons/simple-icons/blob/develop/icons/bilibili.svg
const socialLinks = [
  {
    name: 'GitHub',
    href: PROFILE.github,
    viewBox: '0 0 16 16',
    icon: 'M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z',
  },
  {
    name: 'Twitter',
    href: PROFILE.twitter,
    viewBox: '0 0 16 16',
    icon: 'M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z',
  },
  {
    name: 'Bilibili',
    href: PROFILE.bilibili,
    viewBox: '0 0 24 24',
    icon: 'M17.813 4.653h.854c1.51.054 2.769.578 3.773 1.574 1.004.995 1.524 2.249 1.56 3.76v7.36c-.036 1.51-.556 2.769-1.56 3.773s-2.262 1.524-3.773 1.56H5.333c-1.51-.036-2.769-.556-3.773-1.56S.036 18.858 0 17.347v-7.36c.036-1.511.556-2.765 1.56-3.76 1.004-.996 2.262-1.52 3.773-1.574h.774l-1.174-1.12a1.234 1.234 0 0 1-.373-.906c0-.356.124-.658.373-.907l.027-.027c.267-.249.573-.373.92-.373.347 0 .653.124.92.373L9.653 4.44c.071.071.134.142.187.213h4.267a.836.836 0 0 1 .16-.213l2.853-2.747c.267-.249.573-.373.92-.373.347 0 .662.151.929.4.267.249.391.551.391.907 0 .355-.124.657-.373.906zM5.333 7.24c-.746.018-1.373.276-1.88.773-.506.498-.769 1.13-.786 1.894v7.52c.017.764.28 1.395.786 1.893.507.498 1.134.756 1.88.773h13.334c.746-.017 1.373-.275 1.88-.773.506-.498.769-1.129.786-1.893v-7.52c-.017-.765-.28-1.396-.786-1.894-.507-.497-1.134-.755-1.88-.773zM8 11.107c.373 0 .684.124.933.373.25.249.383.569.4.96v1.173c-.017.391-.15.711-.4.96-.249.25-.56.374-.933.374s-.684-.125-.933-.374c-.25-.249-.383-.569-.4-.96V12.44c0-.373.129-.689.386-.947.258-.257.574-.386.947-.386zm8 0c.373 0 .684.124.933.373.25.249.383.569.4.96v1.173c-.017.391-.15.711-.4.96-.249.25-.56.374-.933.374s-.684-.125-.933-.374c-.25-.249-.383-.569-.4-.96V12.44c.017-.391.15-.711.4-.96.249-.249.56-.373.933-.373Z',
  },
];
---

<button
  class="sidebar-toggle glow-control"
  type="button"
  aria-label="Open navigation"
  data-i18n-aria-label="sidebar.open"
  aria-expanded="false"
  aria-controls="site-sidebar"
  data-sidebar-toggle
  hidden
>
  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true">
    <path
      d="M4 6h16M4 12h16M4 18h16"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
    />
  </svg>
</button>
<aside
  id="site-sidebar"
  class="sidebar"
  aria-label="Site navigation"
  data-i18n-aria-label="sidebar.navigation"
  data-site-sidebar
  tabindex="-1"
>
  <noscript>
    <style is:inline>
      .sidebar[data-site-sidebar] > noscript {
        display: contents;
      }
      @media (max-width: 1023px) {
        .sidebar[data-site-sidebar] {
          position: relative;
          top: auto;
          width: 100%;
          max-width: none;
          height: auto;
          transform: none;
          visibility: visible;
          pointer-events: auto;
          border-right: 0;
          border-bottom: 1px solid rgb(var(--border));
        }
      }
    </style>
  </noscript>
  <img
    class="sidebar-background"
    src={background.src}
    width={background.width}
    height={background.height}
    alt=""
    aria-hidden="true"
    loading="eager"
    decoding="sync"
    fetchpriority="high"
  />
  <div class="sidebar-content">
    <button
      class="sidebar-close glow-control"
      type="button"
      aria-label="Close navigation"
      data-i18n-aria-label="sidebar.close"
      data-sidebar-close
      hidden
    >
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true">
        <path
          d="m6 6 12 12M18 6 6 18"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
        />
      </svg>
    </button>
    <div class="profile">
      <SiteCat />
      <a
        class="profile-name glow-control"
        href={import.meta.env.BASE_URL}
        aria-label={`${SITE_TITLE} home`}
        data-i18n-aria-label="sidebar.profileHome"
        data-i18n-params={JSON.stringify({ name: SITE_TITLE })}
      >
        {SITE_TITLE}
      </a>
    </div>
    <nav
      class="site-navigation"
      aria-label="Main navigation"
      data-i18n-aria-label="sidebar.navigation"
    >
      {navigation.map(({ href, label, translationKey, icon, catIcon, active }) => (
        <a href={href} class:list={['glow-control', { active }]} aria-current={active ? 'page' : undefined}>
          {catIcon ? <CatLogo size={20} /> : icon && (
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false">
              <path d={icon} fill-rule="evenodd" />
            </svg>
          )}
          <span data-i18n={translationKey}>{label}</span>
        </a>
      ))}
    </nav>
    <div class="sidebar-bottom">
      <nav class="social-links" aria-label="Social links" data-i18n-aria-label="social.label" hidden>
        {socialLinks.map(({ name, href, viewBox, icon }) => (
          <a
            class="glow-control"
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${name} (opens in a new tab)`}
            data-i18n-aria-label="link.newTab"
            data-i18n-params={JSON.stringify({ name })}
            title={name}
          >
            <svg viewBox={viewBox} width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false">
              <path d={icon} />
            </svg>
          </a>
        ))}
      </nav>
      <Preferences />
    </div>
  </div>
</aside>
<button
  class="sidebar-backdrop"
  type="button"
  aria-label="Close navigation"
  data-i18n-aria-label="sidebar.close"
  data-sidebar-backdrop
  tabindex="-1"
  hidden
></button>

<style>
  .sidebar {
    --background: 24, 27, 35;
    --foreground: 244, 244, 247;
    --gray: 206, 211, 222;
    --link: 178, 222, 255;
    --sidebar-background-wash: 0.26;
    position: sticky;
    top: 0;
    z-index: 30;
    align-self: start;
    isolation: isolate;
    width: 272px;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background-color: rgb(var(--background));
    color: rgb(var(--foreground));
  }

  :global(.dark) .sidebar {
    --sidebar-background-wash: 0.42;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .sidebar {
      --sidebar-background-wash: 0.42;
    }
  }

  .sidebar-background {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
    border-radius: 0;
    pointer-events: none;
  }

  .sidebar::before {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(var(--background), var(--sidebar-background-wash));
    pointer-events: none;
    content: '';
  }

  .sidebar-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 32px;
    height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 28px 24px;
  }

  .profile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
    color: rgb(var(--foreground));
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.3;
    text-decoration: none;
    text-align: center;
    letter-spacing: -0.02em;
  }

  .profile-name {
    font-family: var(--font-brand);
    display: inline-block;
    padding: 0 4px;
    border-radius: 6px;
    color: inherit;
    text-decoration: none;
  }

  .profile-name:is(:hover, :focus-within) {
    color: rgb(var(--accent));
  }

  .site-navigation {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex-shrink: 0;
  }

  .site-navigation a {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 10px 12px;
    border-radius: 10px;
    color: rgb(var(--gray));
    font-size: 0.9375rem;
    line-height: 1.5;
    text-decoration: none;
  }

  .site-navigation svg {
    flex-shrink: 0;
  }

  .site-navigation a:is(:hover, :focus-within, .active),
  .social-links a:is(:hover, :focus-within) {
    color: rgb(var(--accent));
  }

  .site-navigation a.active {
    font-weight: 600;
  }

  .social-links:not([hidden]) {
    display: flex;
    align-self: center;
    align-items: center;
    justify-content: center;
    gap: 2px;
    flex-shrink: 0;
  }

  .social-links a {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    color: rgb(var(--gray));
  }

  .sidebar-bottom {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-top: auto;
    padding-top: 24px;
    border-top: 1px solid rgba(var(--foreground), 0.22);
    flex-shrink: 0;
  }

  .sidebar-toggle,
  .sidebar-close,
  .sidebar-backdrop {
    display: none;
  }

  @media (max-width: 1023px) {
    .sidebar {
      position: fixed;
      left: 0;
      max-width: calc(100vw - 24px);
      z-index: 50;
      transform: translateX(-100%);
      visibility: hidden;
      pointer-events: none;
      box-shadow: var(--panel-shadow, 12px 0 40px rgba(0, 0, 0, 0.15));
      transition:
        transform 180ms ease,
        visibility 0s linear 180ms;
    }

    .sidebar[data-open='true'] {
      transform: translateX(0);
      visibility: visible;
      pointer-events: auto;
      transition-delay: 0s;
    }

    :global(:root[data-theme-transition='colors']) .sidebar {
      transition:
        transform 180ms ease,
        visibility 0s linear 180ms,
        background-color 520ms cubic-bezier(0.22, 1, 0.36, 1),
        color 520ms cubic-bezier(0.22, 1, 0.36, 1),
        border-color 520ms cubic-bezier(0.22, 1, 0.36, 1),
        box-shadow 520ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    :global(:root[data-theme-transition='colors']) .sidebar[data-open='true'] {
      transition-delay: 0s;
    }

    .sidebar-toggle:not([hidden]),
    .sidebar-close:not([hidden]) {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: transparent;
      color: rgb(var(--foreground));
      cursor: pointer;
    }

    .sidebar-toggle {
      position: fixed;
      top: 16px;
      left: 16px;
      z-index: 35;
    }

    .sidebar-close {
      position: absolute;
      top: 20px;
      right: 16px;
    }

    .sidebar-backdrop:not([hidden]) {
      position: fixed;
      inset: 0;
      z-index: 40;
      display: block;
      padding: 0;
      border: 0;
      background: rgba(0, 0, 0, 0.38);
      cursor: pointer;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar {
      transition: none;
    }
  }
</style>

<script>
  import { initSidebar } from '../../scripts/navigation';

  initSidebar();
</script>
